# Non-secret operator configuration. Combine with the existing TLS/storage settings.
# Secret file values must be provisioned independently; no sample credentials are supplied.
MARGIN_AUTH_MODE=oidc
MARGIN_APPLICATION_ORIGIN=https://margin.example.org
MARGIN_OIDC_ISSUER=https://identity.example.org
MARGIN_OIDC_CLIENT_ID=registered-confidential-client
MARGIN_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
MARGIN_SESSION_SECRET_FILE=/run/secrets/session-secret-base64
MARGIN_IDENTITY_HMAC_KEY_FILE=/run/secrets/identity-hmac-key-base64
MARGIN_IDENTITY_DATABASE_URL_FILE=/run/secrets/identity-database-url
MARGIN_IDENTITY_DATABASE_CA_FILE=/run/certificates/postgres-ca.pem
# Exact signed ACR values confirmed by the institution's provider. Empty denies privileged login.
MARGIN_OIDC_MFA_ACR_VALUES=
# Extra exact HTTPS provider origins only if documented by the configured identity provider.
MARGIN_OIDC_PROVIDER_ORIGINS=

# Optional durable annotation synchronization; migration 002 and trusted document grants required.
# Use a distinct restricted login inheriting margin_sync_runtime only.
MARGIN_SYNC_ENABLED=false
MARGIN_SYNC_DATABASE_URL_FILE=/run/secrets/margin-sync-database-url
# MARGIN_SYNC_DATABASE_CA_FILE=/run/secrets/rds-ca.pem

# Optional Canvas launch foundation; migration 003 and explicit installation/enrollment mappings required.
# Use a distinct restricted login inheriting margin_lms_runtime only. No credentials are accepted by the website.
MARGIN_LMS_ENABLED=false
MARGIN_LMS_DATABASE_URL_FILE=/run/secrets/margin-lms-database-url
MARGIN_LMS_LOOKUP_KEY_FILE=/run/secrets/margin-lms-lookup-key
# MARGIN_LMS_DATABASE_CA_FILE=/run/secrets/rds-ca.pem
