{
  "name": "margin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @margin/web",
    "dev:api": "npm run dev -w @margin/api",
    "dev:marketing": "npm run dev -w @margin/marketing",
    "build:marketing": "npm run build -w @margin/marketing",
    "build:lms": "npm run build -w @margin/lms",
    "build": "npm run build:lms && npm run build -w @margin/web && npm run build -w @margin/api && npm run build -w @margin/extension && npm run build:marketing",
    "pretypecheck": "npm run build:lms",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "pretest": "npm run build:lms",
    "test:marketing": "node --import tsx --test apps/marketing/tests/contracts.test.mjs",
    "test:e2e": "playwright test",
    "setup:dev": "node scripts/setup-dev.mjs",
    "predev": "npm run setup:dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html,md,yml}\"",
    "test:offline": "npm run setup:dev && node scripts/check-offline.mjs",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "trust:dev": "node scripts/trust-local-cert.mjs --trust",
    "untrust:dev": "node scripts/trust-local-cert.mjs --remove",
    "check:tls": "node scripts/trust-local-cert.mjs --status"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
