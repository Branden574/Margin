# Run npm run setup:dev. The generated .local/api.env is private and must never be committed.
# Every application connection uses TLS; the default API identity expires after one hour.
MARGIN_API_TOKEN=
# Canonical base64 of exactly 32 random bytes, provisioned separately from encrypted object data.
MARGIN_MASTER_KEY=
MARGIN_TLS_KEY_FILE=
MARGIN_TLS_CERT_FILE=
MARGIN_API_PORT=4100
MARGIN_DATA_DIR=
MARGIN_TENANT_ID=local-workspace
MARGIN_USER_ID=local-user
